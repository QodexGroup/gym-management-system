# Copy to .env.development and fill in. Never commit .env.development.

VITE_API_BASE_URL=http://localhost:8000/api

# Firebase (dev project). In production these come from Firebase Remote Config via injectConfig.js.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Google Analytics 4 (gtag.js). Optional. Independent of the Firebase project.
# Leave empty locally so dev traffic never hits the production property.
# To test locally: set the ID (G-XXXXXXXXXX) and VITE_ANALYTICS_DEBUG=true, then watch GA4 > DebugView.
# Production: set VITE_GA_MEASUREMENT_ID in .github/workflows/firebase-hosting-merge.yml.
VITE_GA_MEASUREMENT_ID=
VITE_ANALYTICS_DEBUG=false

# Cloudflare R2 public base URL for stored files/receipts (no trailing slash)
VITE_R2_PUBLIC_URL=
